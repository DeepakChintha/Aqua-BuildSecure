{
  "name": "clinexa-medidesk",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:frontend": "vite --host 0.0.0.0",
    "dev:backend": "npx tsx watch src/backend/server.ts",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "vite build",
    "build:backend": "npx tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "typecheck": "npx tsc -p tsconfig.server.json --noEmit",
    "lint": "npx eslint src/backend/**/*.ts",
    "format": "npx prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "npx vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@tailwindcss/vite": "^4.1.14",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "lucide-react": "^0.468.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.4",
    "recharts": "^2.13.3",
    "tailwindcss": "^4.1.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.1"
  }
}
